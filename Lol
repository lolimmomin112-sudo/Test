-- FLIGHT LOGIC (optimized)
-- ============================================================
local flyBodyVelocity = nil
local flyBodyGyro = nil

local function cleanupFly()
    pcall(function()
        if flyBodyVelocity and flyBodyVelocity.Parent then flyBodyVelocity:Destroy() end
        if flyBodyGyro and flyBodyGyro.Parent then flyBodyGyro:Destroy() end
        flyBodyVelocity = nil
        flyBodyGyro = nil
    end)
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum then hum.PlatformStand = false end
        if hrp then
            hrp.Velocity = Vector3.zero
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end)
end

RunService.Heartbeat:Connect(function()
    if not getgenv().Fly_Enabled then
        if flyBodyVelocity or flyBodyGyro then cleanupFly() end
        return
    end

    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local cam = workspace.CurrentCamera
        if not cam then return end

        hum.PlatformStand = true

        if not flyBodyVelocity or not flyBodyVelocity.Parent then
            flyBodyVelocity = Instance.new("BodyVelocity")
            flyBodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            flyBodyVelocity.Velocity = Vector3.zero
            flyBodyVelocity.Parent = hrp
        end

        if not flyBodyGyro or not flyBodyGyro.Parent then
            flyBodyGyro = Instance.new("BodyGyro")
            flyBodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            flyBodyGyro.P = 1e4
            flyBodyGyro.D = 100
            flyBodyGyro.CFrame = hrp.CFrame
            flyBodyGyro.Parent = hrp
        end

        local moveDir = hum.MoveDirection
        local camRight = cam.CFrame.RightVector
        local camLook = cam.CFrame.LookVector

        local fwd = camLook:Dot(moveDir)
        local strafe = camRight:Dot(moveDir)
        local velocity = Vector3.zero

        if math.abs(fwd) > 0.01 or math.abs(strafe) > 0.01 then
            velocity = (camLook * fwd + camRight * strafe).Unit * getgenv().Fly_Speed
        end

        local goUp = UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.ButtonA)
        local goDown = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.ButtonB)

        if goUp then velocity = velocity + Vector3.new(0, getgenv().Fly_Speed, 0) end
        if goDown then velocity = velocity - Vector3.new(0, getgenv().Fly_Speed, 0) end

        flyBodyVelocity.Velocity = velocity
        flyBodyGyro.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(-camLook.X, -camLook.Z), 0)
    end)
end)

