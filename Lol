    pcall(function()
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 2
        Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
        Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.ClockTime = 14
        Lighting.TimeOfDay = "14:00:00"
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
    end)
end

local function enableFullBright()
    if fullBrightEnabled then return end
    
    if not originalLightingSettings.Ambient then
        originalLightingSettings = {
            Ambient = Lighting.Ambient,
            Brightness = Lighting.Brightness,
            ColorShift_Top = Lighting.ColorShift_Top,
            ColorShift_Bottom = Lighting.ColorShift_Bottom,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            ClockTime = Lighting.ClockTime,
            TimeOfDay = Lighting.TimeOfDay,
            GlobalShadows = Lighting.GlobalShadows,
            FogEnd = Lighting.FogEnd,
            FogStart = Lighting.FogStart
        }
    end
    
    fullBrightEnabled = true
    applyFullBright()
    
    if fullBrightConnection then fullBrightConnection:Disconnect() end
    fullBrightConnection = Lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
        if fullBrightEnabled then
            task.wait(0.05)
            applyFullBright()
        end
    end)
end

local function disableFullBright()
    if not fullBrightEnabled then return end
    fullBrightEnabled = false
    
    if fullBrightConnection then
        fullBrightConnection:Disconnect()
        fullBrightConnection = nil
    end
    
    if originalLightingSettings.Ambient then
        pcall(function()
            Lighting.Ambient = originalLightingSettings.Ambient
            Lighting.Brightness = originalLightingSettings.Brightness
            Lighting.ColorShift_Top = originalLightingSettings.ColorShift_Top
            Lighting.ColorShift_Bottom = originalLightingSettings.ColorShift_Bottom
            Lighting.OutdoorAmbient = originalLightingSettings.OutdoorAmbient
            Lighting.ClockTime = originalLightingSettings.ClockTime
            Lighting.TimeOfDay = originalLightingSettings.TimeOfDay
            Lighting.GlobalShadows = originalLightingSettings.GlobalShadows
            Lighting.FogEnd = originalLightingSettings.FogEnd
            Lighting.FogStart = originalLightingSettings.FogStart
        end)
    end
end

-- ========== XRAY ==========
local function setXrayTransparency(transparency)
    local parts = Workspace:GetDescendants()
    for _, part in pairs(parts) do
        if part:IsA("BasePart") then
            local isPlayerPart = false
            local check = part.Parent
            while check do
                if check:IsA("Model") and check:FindFirstChild("Humanoid") then
                    isPlayerPart = true
                    break
                end
                check = check.Parent
            end
            if not isPlayerPart then
                pcall(function()
                    part.LocalTransparencyModifier = transparency
                end)
            end
        end
    end
end

local function enableXray()
    if xrayEnabled then return end
    xrayEnabled = true
    setXrayTransparency(0.85)
    
    if xrayDescendantConnection then xrayDescendantConnection:Disconnect() end
    xrayDescendantConnection = Workspace.DescendantAdded:Connect(function(descendant)
        if xrayEnabled and descendant:IsA("BasePart") then
            local isPlayerPart = false
            local check = descendant.Parent
            while check do
                if check:IsA("Model") and check:FindFirstChild("Humanoid") then
                    isPlayerPart = true
                    break
                end
                check = check.Parent
            end
            if not isPlayerPart then
                pcall(function()
                    descendant.LocalTransparencyModifier = 0.85
                end)
            end
        end
    end)
end

local function disableXray()
    if not xrayEnabled then return end
    xrayEnabled = false
    setXrayTransparency(0)
    if xrayDescendantConnection then
        xrayDescendantConnection:Disconnect()
        xrayDescendantConnection = nil
    end
end

-- ========== ESP ==========
local ESP_CONFIG = {
    FillTransparency = CONFIG.ESP.FILL_TRANSPARENCY,
    OutlineTransparency = CONFIG.ESP.OUTLINE_TRANSPARENCY,
    OutlineColor = Color3.fromRGB(255, 255, 255),
    DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
}

local function addESPToPlayer(player)
    if not player or player == LocalPlayer then return end
    if not player.Character then return end
    
    local character = player.Character
    if not character or character:FindFirstChild("HumanoidRootPart") == nil then return end
    
    if espHighlightObjects[player] then
        pcall(function() espHighlightObjects[player]:Destroy() end)
        espHighlightObjects[player] = nil
    end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "WAQURY_ESP"
    highlight.Adornee = character
    highlight.FillColor = getPlayerColorForMM2(player)
    highlight.FillTransparency = ESP_CONFIG.FillTransparency
    highlight.OutlineColor = ESP_CONFIG.OutlineColor
    highlight.OutlineTransparency = ESP_CONFIG.OutlineTransparency
    highlight.DepthMode = ESP_CONFIG.DepthMode
    highlight.Parent = character
    
    espHighlightObjects[player] = highlight
end

local function removeESPFromPlayer(player)
    if espHighlightObjects[player] then
        pcall(function() espHighlightObjects[player]:Destroy() end)
        espHighlightObjects[player] = nil
    end
end

local function updateESPColorForPlayer(player)
    if not espEnabled then return end
    if not espHighlightObjects[player] then return end
    pcall(function()
        local newColor = getPlayerColorForMM2(player)
        if espHighlightObjects[player].FillColor ~= newColor then
            espHighlightObjects[player].FillColor = newColor
        end
    end)
end

local function startColorUpdateLoop()
    if espColorUpdateLoop then return end
    espColorUpdateLoop = task.spawn(function()
        while espEnabled do
            for player, _ in pairs(espHighlightObjects) do
                if player and player.Character then 
                    updateESPColorForPlayer(player) 
                end
            end
            task.wait(CONFIG.ESP.UPDATE_INTERVAL)
        end
        espColorUpdateLoop = nil
    end)
end

local function enableESP()
    if espEnabled then return end
    espEnabled = true
    
    for _, conn in pairs(espPlayerAddedConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espPlayerAddedConnections = {}
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then 
            task.spawn(function() addESPToPlayer(player) end)
        end
    end
    
    startColorUpdateLoop()
    
    local function onPlayerAdded(player)
        if espEnabled and player ~= LocalPlayer then
            local function onCharacterAdded()
                task.wait(0.5)
                addESPToPlayer(player)
            end
            if player.Character then 
                addESPToPlayer(player)
            else 
                player.CharacterAdded:Once(onCharacterAdded) 
            end
        end
    end
    
    local conn = Players.PlayerAdded:Connect(onPlayerAdded)
    table.insert(espPlayerAddedConnections, conn)
    
    local playerRemovingConn = Players.PlayerRemoving:Connect(function(player)
        removeESPFromPlayer(player)
    end)
    table.insert(espPlayerAddedConnections, playerRemovingConn)
end

local function disableESP()
    if not espEnabled then return end
    espEnabled = false
    
    for _, conn in pairs(espPlayerAddedConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espPlayerAddedConnections = {}
    
    for player, highlight in pairs(espHighlightObjects) do
        pcall(function() highlight:Destroy() end)
    end
    espHighlightObjects = {}
end

