local function spawnJerkTool()
    if jerkToolInstance then
        pcall(function() jerkToolInstance:Destroy() end)
        jerkToolInstance = nil
    end
    
    local backpack = LocalPlayer.Backpack
    if backpack then
        local existingTool = backpack:FindFirstChild('Jerk Off R15')
        if existingTool then
            pcall(function() existingTool:Destroy() end)
        end
    end
    
    local Tool = Instance.new('Tool')
    Tool.Name = 'Jerk Off R15'
    Tool.RequiresHandle = false
    Tool.Parent = backpack
    
    local animTrack = nil
    
    Tool.Equipped:Connect(function()
        local Humanoid = (LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()):FindFirstChildOfClass('Humanoid')
        
        if Humanoid then
            local Animation = Instance.new('Animation')
            Animation.AnimationId = jerkToolAnimationId
            animTrack = Humanoid:LoadAnimation(Animation)
            animTrack.Looped = false
            
            animTrack:Play()
            animTrack.TimePosition = 0.58
            animTrack:AdjustSpeed(0.4)
            
            task.spawn(function()
                while animTrack and animTrack.IsPlaying do
                    if animTrack.TimePosition >= 0.63 then
                        animTrack.TimePosition = 0.58
                    end
                    task.wait()
                end
            end)
        end
    end)
    
    Tool.Unequipped:Connect(function()
        if animTrack then
            animTrack:Stop()
            animTrack = nil
        end
    end)
    
    jerkToolInstance = Tool
    
    WindUI:Notify({
        Title = "Jerk Tool",
        Content = "Tool successfully created in inventory!",
        Duration = 2,
        Icon = "check"
    })
end

