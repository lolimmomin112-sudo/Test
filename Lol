local function SecureNetwork()
    local mt = getrawmetatable(game)
    local oldIndex = mt.__index
    local oldNewIndex = mt.__newindex
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__index = newcclosure(function(t, k)
        if not checkcaller() then
            if k == "WalkSpeed" or k == "JumpPower" then return 16 end
            if k == "Health" or k == "MaxHealth" then return 100 end
            if k == "Velocity" or k == "AssemblyLinearVelocity" then return Vector3.new(0, 0, 0) end
            if getgenv().Aimbot_Enabled then
                if k == "Hit" or k == "Target" then
                    return k == "Hit" and Camera.CFrame * CFrame.new(0, 0, -1000) or oldIndex(t, k)
                elseif (k == "X" or k == "Y") and typeof(t) == "Instance" and t:IsA("Mouse") then
                    return k == "X" and (Camera.ViewportSize.X / 2) or (Camera.ViewportSize.Y / 2)
                end
            end
        end
        return oldIndex(t, k)
    end)

    mt.__newindex = newcclosure(function(t, k, v)
        if not checkcaller() and (k == "WalkSpeed" or k == "JumpPower") then return end
        return oldNewIndex(t, k, v)
    end)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if not checkcaller() then
            if getgenv().Aimbot_Enabled and (method == "ViewportPointToRay" or method == "ScreenPointToRay" or method == "GetMouseLocation") then
                local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                if method == "GetMouseLocation" then return center end
                return oldNamecall(self, center.X, center.Y)
            end
        end
        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
end
