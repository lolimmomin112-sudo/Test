local function isAlive(player)
    if not player or not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getAimTargetPart(character)
    if getgenv().Aimbot_AimHead then
        return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    else
        return character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
    end
end

local function findBestTarget()
    local bestScore, bestPart = math.huge, nil
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local effectiveFOV = getgenv().Aimbot_FOV * (isMobile and 0.92 or 1.0)

    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myHRP and myHRP.Position or Vector3.new()

    local maxDist = 300
    local closestDist = math.huge

    pcall(function()
        for _,player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and isAlive(player) and (not getgenv().Murder_Aimbot or getMM2Role(player) == "Murderer") then
                local targetPart = getAimTargetPart(player.Character)
                if targetPart and targetPart.Parent then
                    local physDist = myPos.Magnitude > 0 and (targetPart.Position - myPos).Magnitude or 0
                    if physDist < closestDist then closestDist = physDist end
                end
            end
        end

        if closestDist > 300 then maxDist = closestDist + 50 end

        for _,player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and isAlive(player) and (not getgenv().Murder_Aimbot or getMM2Role(player) == "Murderer") then
                local targetPart = getAimTargetPart(player.Character)
                if targetPart and targetPart.Parent then
                    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        local physDist = myPos.Magnitude > 0 and (targetPart.Position - myPos).Magnitude or 0
                        if dist < effectiveFOV and physDist <= maxDist and dist < bestScore then
                            bestScore = dist
                            bestPart = targetPart
                        end
                    end
                end
            end
        end
    end)
    return bestPart
end

local aimbotConnection = nil
local function startAimbot()
    if aimbotConnection then return end
    aimbotConnection = RunService.RenderStepped:Connect(function()
        if getgenv().Aimbot_Enabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.Health > 0 then
            local skipLock = false
            if not getgenv().Murder_Aimbot then
                if os.clock() - lastCameraMove < 0.02 then
                    skipLock = true
                end
            end
            if not skipLock then
                local target = findBestTarget()
                if target and target.Parent then
                    local targetPos = target.Position
                    local velocity = target.AssemblyLinearVelocity or target.Velocity
                    if velocity and velocity.Magnitude > 0.5 then
                        targetPos = targetPos + velocity * 0.20
                    end
                    local camPos = Camera.CFrame.Position
                    local lookVector = (targetPos - camPos).Unit
                    Camera.CFrame = CFrame.new(camPos, camPos + lookVector)
                end
            end
        end
    end)
end

local function stopAimbot()
    if aimbotConnection then
        aimbotConnection:Disconnect()
        aimbotConnection = nil
    end
end

