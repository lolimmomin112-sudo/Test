local function MonitorRolesForEarlyDetect(player)
    if player == LocalPlayer then return end
    
    local function onChildAdded(child)
        if not Settings.EarlyRoleDetect then return end
        if child:IsA("Tool") then
            if child.Name == "Knife" then
                Library:Notify("Role Detected Early", player.DisplayName .. " (@" .. player.Name .. ") is MURDERER!", 5)
            elseif child.Name == "Gun" then
                Library:Notify("Role Detected Early", player.DisplayName .. " (@" .. player.Name .. ") is SHERIFF!", 5)
            end
        end
    end
    
    local function setupBackpack(backpack)
        table.insert(_G.EarlyDetectConnections, backpack.ChildAdded:Connect(onChildAdded))
        for _, child in ipairs(backpack:GetChildren()) do
            onChildAdded(child)
        end
    end
    
    local function setupCharacter(char)
        table.insert(_G.EarlyDetectConnections, char.ChildAdded:Connect(onChildAdded))
        for _, child in ipairs(char:GetChildren()) do
            onChildAdded(child)
        end
    end
    
    table.insert(_G.EarlyDetectConnections, player.CharacterAdded:Connect(setupCharacter))
    if player.Character then
        setupCharacter(player.Character)
    end
    
    table.insert(_G.EarlyDetectConnections, player.ChildAdded:Connect(function(child)
        if child.Name == "Backpack" then
            setupBackpack(child)
        end
    end))
    
    local bp = player:FindFirstChild("Backpack")
    if bp then
        setupBackpack(bp)
    end
end

