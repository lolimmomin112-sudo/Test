local function SetupAutoTeleport()
    local function CheckAndTeleport()
        task.wait(2)
        TeleportToActiveMap()
    end
    
    local normalFolder = Services.Workspace:FindFirstChild("Normal")
    if normalFolder then
        normalFolder.DescendantAdded:Connect(function(desc)
            if desc.Name == "SpawnPoints" or desc.Name == "Spawns" or desc.Name == "PlayerSpawn" then
                CheckAndTeleport()
            end
        end)
    end
    
    Services.Workspace.ChildAdded:Connect(function(child)
        if child.Name == "Normal" then
            task.wait(1.5)
            CheckAndTeleport()
            child.DescendantAdded:Connect(function(desc)
                if desc.Name == "SpawnPoints" or desc.Name == "Spawns" or desc.Name == "PlayerSpawn" then
                    CheckAndTeleport()
                end
            end)
        end
    end)
    
    SafeConnect(Services.RunService.Heartbeat, function()
        if Settings.AutoTeleportMap and not Services.Workspace:FindFirstChild("Normal") then
            local map = Services.Workspace:FindFirstChild("Map")
            if map and not map:FindFirstChild("SpawnPoints") then
                task.wait(0.5)
                TeleportToActiveMap()
            end
        end
    end)
    
    Services.Players.PlayerAdded:Connect(function()
        task.wait(3)
        TeleportToActiveMap()
    end)
end

