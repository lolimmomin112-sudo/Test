    else
        WindUI:Notify({ Title = "Silent Aim", Content = "Shooting Remote not detected in Gun.", Duration = 2, Icon = "alert-circle" })
    end
    task.spawn(function()
        task.wait(0.12)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:UnequipTools()
        elseif gun.Parent == char then
