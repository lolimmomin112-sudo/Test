    if player == LocalPlayer then return end
    local highlight = Instance.new("Highlight")
    local billboard = Instance.new("BillboardGui")
    local nameLabel = Instance.new("TextLabel")
    local tracer = Instance.new("Frame", espFolder)
    tracer.BorderSizePixel = 0
    tracer.AnchorPoint = Vector2.new(0.5, 0.5)
    local enabled = false

    local connection = RunService.RenderStepped:Connect(function()
        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") or not getgenv().ESP_Enabled then
            highlight.Enabled = false
            billboard.Enabled = false
            tracer.Visible = false
            return
        end

        local hrp = player.Character.HumanoidRootPart
        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        
        local role = getMM2Role(player)
        local pColor = Color3.fromRGB(0, 255, 0)
        if role == "Sheriff" then pColor = Color3.fromRGB(0, 120, 255)
        elseif role == "Murderer" then pColor = Color3.fromRGB(255, 0, 0) end

        if onScreen then
            if getgenv().ESP_Boxes then
                highlight.Parent = player.Character
                highlight.FillColor = pColor
                highlight.OutlineColor = pColor
                highlight.FillTransparency = 0.5
                highlight.OutlineTransparency = 0
                highlight.Enabled = true
            else highlight.Enabled = false end

            if getgenv().ESP_Names then
                billboard.Parent = player.Character.Head
                billboard.Size = UDim2.new(0, 200, 0, 50)
                billboard.Adornee = player.Character.Head
                billboard.AlwaysOnTop = true
                billboard.StudsOffset = Vector3.new(0, 2, 0)
                nameLabel.Parent = billboard
                nameLabel.Size = UDim2.new(1, 0, 1, 0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = player.Name
                nameLabel.TextColor3 = pColor
                nameLabel.TextStrokeTransparency = 0
                nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
                nameLabel.TextSize = 14
                nameLabel.Font = Enum.Font.Code
                billboard.Enabled = true
            else billboard.Enabled = false end

            if getgenv().ESP_Tracers then
                local from = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                local to = Vector2.new(pos.X, pos.Y)
                local diff = to - from
                tracer.Size = UDim2.new(0, diff.Magnitude + 60, 0, 1)
                tracer.Position = UDim2.new(0, (from.X + to.X)/2, 0, (from.Y + to.Y)/2)
                tracer.Rotation = math.deg(math.atan2(diff.Y, diff.X))
                tracer.BackgroundColor3 = pColor
                tracer.Visible = true
            else tracer.Visible = false end
        else
            highlight.Enabled = false
            billboard.Enabled = false
            tracer.Visible = false
        end
    end)
end

