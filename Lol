local function startFlingOnTouch()
    if flingOnTouchEnabled then return end
    flingOnTouchEnabled = true
    
    if not ReplicatedStorage:FindFirstChild("juisdfj0i32i0eidsuf0iok") then
        local detection = Instance.new("Decal")
        detection.Name = "juisdfj0i32i0eidsuf0iok"
        detection.Parent = ReplicatedStorage
    end
    
    flingOnTouchConnection = RunService.Heartbeat:Connect(function()
        if not flingOnTouchEnabled then return end
        
        local lp = LocalPlayer
        local c = lp.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player == lp then continue end
            if flingCooldown[player] then continue end
            
            local targetChar = player.Character
            if not targetChar then continue end
            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
            if not targetHrp then continue end
            
            local dist = (hrp.Position - targetHrp.Position).Magnitude
            if dist < CONFIG.FLING.DISTANCE then
                flingCooldown[player] = true
                WindUI:Notify({ Title = "Fling on Touch", Content = "Flinging " .. player.Name .. "!", Duration = 2, Icon = "zap" })
                
                task.spawn(function()
                    local vel = targetHrp.Velocity
                    targetHrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                    RunService.RenderStepped:Wait()
                    if targetChar and targetChar.Parent and targetHrp and targetHrp.Parent then
                        targetHrp.Velocity = vel
                    end
                    RunService.Stepped:Wait()
                    if targetChar and targetChar.Parent and targetHrp and targetHrp.Parent then
                        targetHrp.Velocity = vel + Vector3.new(0, 10, 0)
                    end
                    
                    task.wait(CONFIG.FLING.COOLDOWN)
                    flingCooldown[player] = nil
                end)
            end
        end
    end)
    
    WindUI:Notify({ Title = "Fling on Touch", Content = "Auto-fling on touch enabled!", Duration = 2, Icon = "zap" })
end

local function stopFlingOnTouch()
