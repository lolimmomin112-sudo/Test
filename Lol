-- MM2 Role Detection
local mm2_roles = {}
local RoleSelect = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Gameplay") and ReplicatedStorage.Remotes.Gameplay:FindFirstChild("RoleSelect")
if RoleSelect then
    RoleSelect.OnClientEvent:Connect(function(player, role)
        if typeof(player) == "Instance" and player:IsA("Player") then
            mm2_roles[player.Name] = role
        end
    end)
end

local function getMM2Role(player)
    local roleFromRemote = mm2_roles[player.Name]
    if roleFromRemote and roleFromRemote ~= "Innocent" then return roleFromRemote end
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    if char then
        if char:FindFirstChild("Gun") or char:FindFirstChild("ClassicGun") then return "Sheriff" end
        if char:FindFirstChild("Knife") or char:FindFirstChild("MurdererKnife") then return "Murderer" end
    end
    if backpack then
        if backpack:FindFirstChild("Gun") or backpack:FindFirstChild("ClassicGun") then return "Sheriff" end
        if backpack:FindFirstChild("Knife") or backpack:FindFirstChild("MurdererKnife") then return "Murderer" end
    end
    local displayName = player.DisplayName:lower()
    if displayName:find("sheriff") then return "Sheriff" end
    if displayName:find("murderer") then return "Murderer" end
    return "Innocent"
end

