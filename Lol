local FlingSection = Tabs.AutofarmTab:Section({ Title = "Fling System", Box = true, BoxBorder = true, Opened = true })

FlingSection:Toggle({
    Title = "Auto Fling Murderer",
    Default = false,
    Callback = function(state)
        getgenv().InstaWin_FlingMurderer = state
        if state then
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if getgenv().GetMM2Role and getgenv().GetMM2Role(p) == "Murderer" then
                        WindUI:Notify({ Title = "Fling Murderer", Content = "Flinging murderer!", Duration = 2 })
                        break
                    end
                end
            end
        end
    end
})

FlingSection:Toggle({
    Title = "Auto Fling Sheriff",
    Default = false,
    Callback = function(state)
        getgenv().InstaWin_FlingSheriff = state
        if state then
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if getgenv().GetMM2Role and getgenv().GetMM2Role(p) == "Sheriff" then
