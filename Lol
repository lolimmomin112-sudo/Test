-- Coin Farm Collection
task.spawn(function()
    while true do
        if Settings.CoinFarmEnabled then
            if not State.PreFarmCFrame and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                State.PreFarmCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
            end
            
            if State.IsFlingingFromFarm then
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local murderer = GetTargetByRole("Murderer")
                
                if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                    local mRoot = murderer.Character.HumanoidRootPart
                    local mHum = murderer.Character:FindFirstChildOfClass("Humanoid")
                    
                    if mHum and mHum.Health > 0 and root then
                        root.Anchored = false
                        Settings.TouchFling = true
                        for _, child in ipairs(LocalPlayer.Character:GetDescendants()) do
                            if child:IsA("BasePart") then
                                child.CanCollide = true
                            end
                        end
                        local multiplier = Settings.FlingPower * 120
                        root.AssemblyLinearVelocity = Vector3.new(multiplier, multiplier, multiplier)
                        root.AssemblyAngularVelocity = Vector3.new(0, multiplier, 0)
                        root.CFrame = mRoot.CFrame * CFrame.new(math.random(-1, 1) * 0.1, 0, math.random(-1, 1) * 0.1)
                    end
                    task.wait(0.02)
                else
                    Settings.TouchFling = false
                    if root then
                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        root.Anchored = true
                        if not State.WasUnderground then
                            root.CFrame = root.CFrame * CFrame.new(0, -6.5, 0)
                            State.WasUnderground = true
                        end
                    end
                    task.wait(0.5)
                end
            else
                Settings.TouchFling = false
                local nearest = GetNearestCoin()
                if nearest then
                    State.WasUnderground = true
                    CollectCoin(nearest)
                else
                    local character = LocalPlayer.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    if root then
                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        if not State.WasUnderground then
                            root.CFrame = root.CFrame * CFrame.new(0, -6.5, 0)
                            State.WasUnderground = true
                        end
                        root.Anchored = true
                    end
                    task.wait(0.25)
                end
            end
        else
            if State.WasUnderground then
                Settings.TouchFling = false
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.Anchored = false
                    if State.PreFarmCFrame then
                        root.CFrame = State.PreFarmCFrame
                    else
                        root.CFrame = root.CFrame * CFrame.new(0, 7.5, 0)
                    end
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
                State.WasUnderground = false
                State.PreFarmCFrame = nil
            end
            task.wait(0.5)
        end
    end
end)

