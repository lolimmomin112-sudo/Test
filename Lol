-- Auto Farm Logic (optimized)
local function returncoincontainer()
    for _, v in workspace:GetChildren() do
        if v:FindFirstChild("CoinContainer") and v:IsA("Model") then
            return v:FindFirstChild("CoinContainer")
        end
    end
    return false
end

local function StealthMove(targetPosition)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local originalCanCollide = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            originalCanCollide[part] = true
            part.CanCollide = false
        end
    end

    local startPos = hrp.Position
    local distance = (startPos - targetPosition).Magnitude
    local steps = math.max(4, math.floor(distance / math.random(1, 2)))

    for i = 1, steps do
        if not getgenv().AutoFarm_Enabled then break end
        local alpha = i / steps
        local nextPos = startPos:Lerp(targetPosition, alpha)
        local randomOffset = Vector3.new(math.random(-0.05, 0.05), 0.02, math.random(-0.05, 0.05))
        local targetCF = CFrame.new(nextPos + randomOffset)
        local currentPos = hrp.Position
        local dt = RunService.Heartbeat:Wait()
        hrp.CFrame = targetCF
        hrp.AssemblyLinearVelocity = (targetCF.Position - currentPos) / dt
        hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
    end

    hrp.CFrame = CFrame.new(targetPosition)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    for part, wasCollidable in pairs(originalCanCollide) do
        if part and wasCollidable then
            part.CanCollide = true
        end
    end
    hum:ChangeState(Enum.HumanoidStateType.Running)
end

local lastFarmTime = 0
task.spawn(function()
    while task.wait(0.15) do
        local currentTime = os.clock()
        if getgenv().AutoFarm_Enabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and returncoincontainer() and (currentTime - lastFarmTime >= math.random(2.0, 3.5)) then
            lastFarmTime = currentTime
            local container = returncoincontainer()
            local coins = container:GetChildren()
            
            table.sort(coins, function(a, b)
                local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not hrp or not a:IsA("BasePart") or not b:IsA("BasePart") then return false end
                return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
            end)

            for _, v in pairs(coins) do
                if not getgenv().AutoFarm_Enabled or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then break end
                if v:IsA("BasePart") and v:GetAttribute("CoinID") == "Coin" and v:FindFirstChild("TouchInterest") then
                    local targetCoinPosition = v.Position
                    local hrp = LocalPlayer.Character.HumanoidRootPart
                    local distanceToCoin = (hrp.Position - targetCoinPosition).Magnitude
                    local shouldProcess = distanceToCoin <= getgenv().FarmRange
                    
                    if shouldProcess then
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and isAlive(p) and getMM2Role(p) == "Murderer" then
                                local murdererHRP = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                                if murdererHRP then
                                    local distToMurderer = (murdererHRP.Position - hrp.Position).Magnitude
                                    local distToCoin = (murdererHRP.Position - targetCoinPosition).Magnitude
                                    if distToMurderer < MURDERER_AVOID_RANGE or distToCoin < MURDERER_AVOID_RANGE then
                                        shouldProcess = false
                                        break
                                    end
                                end
                            end
                        end
                    end
                    
                    if shouldProcess then
                        local originalPlayerPosition = hrp.CFrame.Position
                        StealthMove(targetCoinPosition)
                        if firetouchinterest then
                            firetouchinterest(hrp, v, 0)
                            task.wait(math.random(8, 20) / 100)
                            firetouchinterest(hrp, v, 1)
                        end
                        StealthMove(originalPlayerPosition)
                        task.wait(math.random(190, 430) / 100)
                    end
                end
            end
        end
    end
end)

-- Fling Logic
local function FlingTarget(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if targetHRP and myHRP then
        local oldPos = myHRP.CFrame
        local oldVelocity = myHRP.Velocity
        
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanTouch = true
                part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5, 100, 100)
            end
        end
        
        local bodyThrust = Instance.new("BodyThrust")
        bodyThrust.Force = Vector3.new(1e15, 1e15, 1e15)
        bodyThrust.Parent = myHRP
        
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e20, 1e20, 1e20)
        bodyVelocity.Velocity = Vector3.new(1e15, 1e15, 1e15)
        bodyVelocity.Parent = myHRP
        
        local bodyAngular = Instance.new("BodyAngularVelocity")
        bodyAngular.MaxTorque = Vector3.new(1e15, 1e15, 1e15)
        bodyAngular.AngularVelocity = Vector3.new(100000, 100000, 100000)
        bodyAngular.Parent = myHRP
        
        local antiVoidConn
        antiVoidConn = RunService.Heartbeat:Connect(function()
            if not myChar or not myHRP or myHRP.Position.Y < -50 then
                if myHRP then
                    myHRP.CFrame = CFrame.new(0, 100, 0)
                    myHRP.AssemblyLinearVelocity = Vector3.zero
                    myHRP.AssemblyAngularVelocity = Vector3.zero
                end
                antiVoidConn:Disconnect()
            end
        end)
        
        task.spawn(function()
            for i = 1, 100 do
                if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then break end
                myHRP.CFrame = targetHRP.CFrame * CFrame.new(math.random(-10,10), math.random(-5,10), math.random(-10,10))
                myHRP.Velocity = Vector3.new(1e15, 1e15, 1e15)
                myHRP.AssemblyLinearVelocity = Vector3.new(1e15, 1e15, 1e15)
                myHRP.AssemblyAngularVelocity = Vector3.new(1e15, 1e15, 1e15)
                RunService.Heartbeat:Wait()
            end
            bodyThrust:Destroy()
            bodyVelocity:Destroy()
            bodyAngular:Destroy()
            if antiVoidConn then antiVoidConn:Disconnect() end
            myHRP.Velocity = oldVelocity
            myHRP.CFrame = savedPos or oldPos
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanTouch = true
                    part.CustomPhysicalProperties = nil
                end
            end
        end)
    end
end

