-- ========== ROLE DETECTION ==========
local MURDERER_WEAPONS = {
    "Knife", "MurdererKnife", "Dagger", "Sword", "Axe", 
    "ButterflyKnife", "Karambit", "Machete", "Katana"
}

local SHERIFF_WEAPONS = {
    "Gun", "Revolver", "Pistol", "Flintlock", "SheriffGun",
    "Handgun", "Magnum", "Colt"
}

local function hasWeapon(player, weaponsList)
    local character = player.Character
    if not character then return false end
    
    for _, weaponName in pairs(weaponsList) do
        local weapon = character:FindFirstChild(weaponName)
        if weapon and weapon:IsA("Tool") then
            return true
        end
    end
    
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, weaponName in pairs(weaponsList) do
            local weapon = backpack:FindFirstChild(weaponName)
            if weapon and weapon:IsA("Tool") then
                return true
            end
        end
    end
    
    return false
end

local function getPlayerRole(player)
    if not player or player == LocalPlayer then return "Normal" end
    
    local cacheTime = roleCacheTimers[player]
    if cacheTime and (tick() - cacheTime) < ROLE_CACHE_TIME then
        local cachedRole = playerRoleCache[player]
        if cachedRole then return cachedRole end
    end
    
    local character = player.Character
    if not character then return "Unknown" end
    
    local hasMurdererWeapon = hasWeapon(player, MURDERER_WEAPONS)
    local hasSheriffWeapon = hasWeapon(player, SHERIFF_WEAPONS)
    
    local role = "Normal"
    if hasSheriffWeapon then
        role = "Sheriff"
    elseif hasMurdererWeapon then
        role = "Murderer"
    end
    
    if role == "Normal" then
        if character:FindFirstChild("Murderer") or character:FindFirstChild("IsMurderer") then
            role = "Murderer"
        elseif character:FindFirstChild("Sheriff") or character:FindFirstChild("IsSheriff") then
            role = "Sheriff"
        end
    end
    
    playerRoleCache[player] = role
    roleCacheTimers[player] = tick()
    
    return role
end

local function getPlayerColorForMM2(player)
    local role = getPlayerRole(player)
    if role == "Murderer" then 
        return customMurdererColor
    elseif role == "Sheriff" then 
        return customSheriffColor
    else 
        return customNormalColor 
    end
end

