-- ========== FARM ==========
local function GetMap()
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:GetAttribute("MapID") and obj:FindFirstChild("CoinContainer") then
            return obj
        end
    end
    
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:FindFirstChild("CoinContainer") then
            return obj
        end
    end
    
    local coinContainer = workspace:FindFirstChild("CoinContainer")
    if coinContainer and coinContainer.Parent then
        return coinContainer.Parent
    end
    
    return nil
end

local function hasCoins()
    local map = GetMap()
    if not map then return false end
    
    local coinContainer = map:FindFirstChild("CoinContainer")
    if not coinContainer then return false end
    
    for _, coin in ipairs(coinContainer:GetChildren()) do
        local coinVisual = coin:FindFirstChild("CoinVisual") or coin:FindFirstChild("Handle") or coin
        if coinVisual then
            local isCollected = coinVisual:GetAttribute("Collected") or coin:GetAttribute("Collected")
            if not isCollected then
                return true
            end
        end
    end
    return false
end

local function getNearestCoin()
    local hrp = getHRP()
    if not hrp then return nil end
    
    local map = GetMap()
    if not map then return nil end
    
    local coinContainer = map:FindFirstChild("CoinContainer")
    if not coinContainer then return nil end
    
    local closest, closestDist = nil, math.huge
    
    for _, coin in ipairs(coinContainer:GetChildren()) do
        local coinVisual = coin:FindFirstChild("CoinVisual") or coin:FindFirstChild("Handle") or coin
        if coinVisual then
            local isCollected = coinVisual:GetAttribute("Collected") or coin:GetAttribute("Collected")
            if not isCollected then
                local dist = (hrp.Position - coin.Position).Magnitude
                if dist < closestDist then
                    closest = coin
                    closestDist = dist
                end
            end
        end
    end
    
    return closest
end

local function teleportToCoin(coin)
    local hrp = getHRP()
    local humanoid = getHumanoid()
    if not hrp or not humanoid then return false end
    
    local wasPlatformStand = humanoid.PlatformStand
    humanoid.PlatformStand = true
    
    local distance = (hrp.Position - coin.Position).Magnitude
    local duration = math.min(distance / farmingSpeed, CONFIG.FARM.TELEPORT_DURATION)
    
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        CFrame = coin.CFrame + Vector3.new(0, 2, 0)
    })
    
    tween:Play()
    tween.Completed:Wait()
    
    humanoid.PlatformStand = wasPlatformStand
    return true
end

local function canFarm()
    if not isPlayerAlive() then return false end
    if not hasCoins() then return false end
    return true
end

local function startFarming()
    if farmingEnabled then return end
    farmingEnabled = true
    
    farmingLoop = task.spawn(function()
        while farmingEnabled do
            while farmingEnabled and not canFarm() do
                task.wait(1)
            end
            
            if not farmingEnabled then break end
            
            local targetCoin = getNearestCoin()
            if targetCoin then
                pcall(function()
                    teleportToCoin(targetCoin)
                end)
            end
            
            task.wait(CONFIG.FARM.CHECK_INTERVAL)
        end
        farmingLoop = nil
    end)
end

local function stopFarming()
    farmingEnabled = false
    if farmingLoop then
        task.cancel(farmingLoop)
        farmingLoop = nil
    end
end

