-- ========== NEW: AUTO GRAB GUN ==========
local function ScanForDroppedGun()
    for _, object in ipairs(workspace:GetDescendants()) do
        if object and object.Parent then
            if object.Name == "GunDrop" or (object:IsA("Tool") and object.Name == "Gun") then
                local targetPart = object:IsA("BasePart") and object or object:FindFirstChildOfClass("BasePart")
                if targetPart then return targetPart end
            end
        end
    end
    return nil
end

local autoGrabConnection = nil

local function startAutoGrabGun()
    LouisSettings.AutoGrabGun = true
    if autoGrabConnection then return end
    
    autoGrabConnection = task.spawn(function()
        while LouisSettings.AutoGrabGun do
            local activeGun = ScanForDroppedGun()
            if activeGun and not IsGrabbing then
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                if root and humanoid and humanoid.Health > 0 then
                    IsGrabbing = true
                    local originalCFrame = root.CFrame
                    local targetCFrame = activeGun.CFrame + Vector3.new(0, 1.5, 0)
                    root.CFrame = targetCFrame
                    local timeout = 0
                    while timeout < 1.5 do
                        local backpack = LocalPlayer:FindFirstChild("Backpack")
                        if char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) then
                            break
                        end
                        root.CFrame = targetCFrame
                        task.wait(0.05)
                        timeout = timeout + 0.05
                    end
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        root.CFrame = originalCFrame
                    end
                    task.wait(0.3)
                    IsGrabbing = false
                end
            end
            task.wait(0.5)
        end
    end)
end

local function stopAutoGrabGun()
    LouisSettings.AutoGrabGun = false
    if autoGrabConnection then
        task.cancel(autoGrabConnection)
        autoGrabConnection = nil
    end
end

-- ========== NEW: GRAB GUN TELEPORT SHOOT ==========
local function GrabGunTeleportShoot()
    if IsGrabShooting then return end
    IsGrabShooting = true
    local activeGun = ScanForDroppedGun()
    if not activeGun then
        WindUI:Notify({ Title = "Grab & Shoot", Content = "No dropped gun found on map.", Duration = 2.5, Icon = "alert-circle" })
        IsGrabShooting = false
        return
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        WindUI:Notify({ Title = "Grab & Shoot", Content = "Character not ready or dead.", Duration = 2, Icon = "alert-circle" })
        IsGrabShooting = false
        return
    end
    local originalCFrame = root.CFrame
    WindUI:Notify({ Title = "Grab & Shoot", Content = "Teleporting to dropped gun...", Duration = 1.5, Icon = "rocket" })
    root.CFrame = activeGun.CFrame + Vector3.new(0, 1.5, 0)
    local grabbed = false
    local startTime = os.clock()
    while os.clock() - startTime < 1.5 do
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) then
            grabbed = true
            break
        end
        root.CFrame = activeGun.CFrame + Vector3.new(0, 1.5, 0)
        task.wait(0.05)
    end
    if grabbed then
        WindUI:Notify({ Title = "Grab & Shoot", Content = "Gun obtained! Searching for Murderer...", Duration = 1.5, Icon = "check" })
        local targetPlayer = GetTargetByRole("Murderer")
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = targetPlayer.Character.HumanoidRootPart
            root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
            task.wait(0.1)
            local gun = char:FindFirstChild("Gun") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Gun"))
            if gun and gun.Parent == LocalPlayer:FindFirstChild("Backpack") then
                humanoid:EquipTool(gun)
                task.wait(0.08)
            end
            -- Fire gun at target
            local shootRemote = gun and gun:FindFirstChild("Shoot")
            local shootGunRemote = gun and gun:FindFirstChild("ShootGun")
            if shootRemote and shootRemote:IsA("RemoteEvent") then
                shootRemote:FireServer(root.CFrame, CFrame.new(targetRoot.Position))
            elseif shootGunRemote and shootGunRemote:IsA("RemoteFunction") then
                shootGunRemote:InvokeServer(1, targetRoot.Position, "AH2")
            end
            WindUI:Notify({ Title = "Grab & Shoot", Content = "Shot successfully fired at Murderer!", Duration = 3, Icon = "check" })
        else
            WindUI:Notify({ Title = "Grab & Shoot", Content = "Murderer not found or already dead.", Duration = 2.5, Icon = "alert-circle" })
            root.CFrame = originalCFrame
        end
    else
        WindUI:Notify({ Title = "Grab & Shoot", Content = "Grab failed (weapon did not respond/timeout).", Duration = 2.5, Icon = "alert-circle" })
        root.CFrame = originalCFrame
    end
    IsGrabShooting = false
end

