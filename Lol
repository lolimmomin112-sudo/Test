-- =============================
-- ERROR SUPPRESSION
-- =============================
local oldWarn = warn
local oldPrint = print
local oldError = error

warn = function(...)
    local msg = tostring(...)
    if msg and (msg:find("GetServerChannelRemote") or msg:find("SettingsHub") or msg:find("CoreGui")) then return end
    return oldWarn(...)
end

print = function(...)
    local msg = tostring(...)
    if msg and (msg:find("GetServerChannelRemote") or msg:find("SettingsHub") or msg:find("CoreGui")) then return end
    return oldPrint(...)
end

error = function(err, level)
    if type(err) == "string" then
        if err:find("GetServerChannelRemote") or err:find("SettingsHub") or err:find("CoreGui") then return end
    end
    return oldError(err, level)
end

