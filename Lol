-- Wallhop
local DoubleJumpReq = Services.UserInputService.JumpRequest:Connect(function()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    
    if humanoid and Settings.InfiniteJump then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
    
    if not character or not humanoid or not root then return end
    if not State.canWallJump or (tick() - State.lastWallHopTime < 0.18) then return end
    if not (Settings.WHNormal or Settings.WHInstant) then return end
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    local isNearWall = false
    local detectedPart = nil
    
    for i = 0, 7 do
        local angle = math.rad(i * 45)
        local dir = (root.CFrame * CFrame.Angles(0, angle, 0)).LookVector
        local r = Services.Workspace:Raycast(root.Position, dir * Settings.WallHopDist, params)
        if r and r.Instance.CanCollide then
            isNearWall = true
            detectedPart = r.Instance
            break
        end
    end
    
    if isNearWall and humanoid.FloorMaterial == Enum.Material.Air then
        State.lastWallHopTime = tick()
        State.canWallJump = false
        
        local jumpPowerBoost = humanoid.JumpPower > 0 and humanoid.JumpPower or 50
        root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, jumpPowerBoost * 0.95, root.AssemblyLinearVelocity.Z)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        
        if Settings.WHInstant then
            task.spawn(function()
                pcall(function()
                    local angle = math.rad(15)
                    Camera.CFrame *= CFrame.Angles(0, -angle, 0)
                    Services.RunService.RenderStepped:Wait()
                    Camera.CFrame *= CFrame.Angles(0, angle * 2, 0)
                    Services.RunService.RenderStepped:Wait()
                    Camera.CFrame *= CFrame.Angles(0, -angle, 0)
                end)
            end)
        elseif Settings.WHNormal then
            task.spawn(function()
                root.CFrame *= CFrame.Angles(0, math.rad(-30), 0)
                task.wait(0.06)
                root.CFrame *= CFrame.Angles(0, math.rad(30), 0)
            end)
        end
        
        task.wait(0.18)
        State.canWallJump = true
    end
end)
