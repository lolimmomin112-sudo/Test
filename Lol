-- ========== ROLE DETECTION ==========
local MURDERER_WEAPONS = {
    "Knife", "MurdererKnife", "Dagger", "Sword", "Axe", 
    "ButterflyKnife", "Karambit", "Machete", "Katana"
}

local SHERIFF_WEAPONS = {
    "Gun", "Revolver", "Pistol", "Flintlock", "SheriffGun",
    "Handgun", "Magnum", "Colt"
}

local function hasWeapon(player, weaponsList)
    local character = player.Character
    if not character then return false end
    
    for _, weaponName in pairs(weaponsList) do
        local weapon = character:FindFirstChild(weaponName)
        if weapon and weapon:IsA("Tool") then
            return true
        end
    end
    
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, weaponName in pairs(weaponsList) do
            local weapon = backpack:FindFirstChild(weaponName)
            if weapon and weapon:IsA("Tool") then
                return true
            end
        end
    end
    
    return false
end

local function getPlayerRole(player)
    if not player or player == LocalPlayer then return "Normal" end
    
    local cacheTime = roleCacheTimers[player]
    if cacheTime and (tick() - cacheTime) < ROLE_CACHE_TIME then
        local cachedRole = playerRoleCache[player]
        if cachedRole then return cachedRole end
    end
    
    local character = player.Character
    if not character then return "Unknown" end
    
    local hasMurdererWeapon = hasWeapon(player, MURDERER_WEAPONS)
    local hasSheriffWeapon = hasWeapon(player, SHERIFF_WEAPONS)
    
    local role = "Normal"
    if hasSheriffWeapon then
        role = "Sheriff"
    elseif hasMurdererWeapon then
        role = "Murderer"
    end
    
    if role == "Normal" then
        if character:FindFirstChild("Murderer") or character:FindFirstChild("IsMurderer") then
            role = "Murderer"
        elseif character:FindFirstChild("Sheriff") or character:FindFirstChild("IsSheriff") then
            role = "Sheriff"
        end
    end
    
    playerRoleCache[player] = role
    roleCacheTimers[player] = tick()
    
    return role
end

local function getPlayerColorForMM2(player)
    local role = getPlayerRole(player)
    if role == "Murderer" then 
        return customMurdererColor
    elseif role == "Sheriff" then 
        return customSheriffColor
    else 
        return customNormalColor 
    end
end

local function getMurdererPlayer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and getPlayerRole(player) == "Murderer" then
            return player
        end
    end
    return nil
end

local function getSheriffPlayer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and getPlayerRole(player) == "Sheriff" then
            return player
        end
    end
    return nil
end

-- ========== JERK TOOL ==========
local function spawnJerkTool()
    if jerkToolInstance then
        pcall(function() jerkToolInstance:Destroy() end)
        jerkToolInstance = nil
    end
    
    local backpack = LocalPlayer.Backpack
    if backpack then
        local existingTool = backpack:FindFirstChild('Jerk Off R15')
        if existingTool then
            pcall(function() existingTool:Destroy() end)
        end
    end
    
    local Tool = Instance.new('Tool')
    Tool.Name = 'Jerk Off R15'
    Tool.RequiresHandle = false
    Tool.Parent = backpack
    
    local animTrack = nil
    
    Tool.Equipped:Connect(function()
        local Humanoid = (LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()):FindFirstChildOfClass('Humanoid')
        
        if Humanoid then
            local Animation = Instance.new('Animation')
            Animation.AnimationId = jerkToolAnimationId
            animTrack = Humanoid:LoadAnimation(Animation)
            animTrack.Looped = false
            
            animTrack:Play()
            animTrack.TimePosition = 0.58
            animTrack:AdjustSpeed(0.4)
            
            task.spawn(function()
                while animTrack and animTrack.IsPlaying do
                    if animTrack.TimePosition >= 0.63 then
                        animTrack.TimePosition = 0.58
                    end
                    task.wait()
                end
            end)
        end
    end)
    
    Tool.Unequipped:Connect(function()
        if animTrack then
            animTrack:Stop()
            animTrack = nil
        end
    end)
    
    jerkToolInstance = Tool
    
    WindUI:Notify({
        Title = "Jerk Tool",
        Content = "Tool successfully created in inventory!",
        Duration = 2,
        Icon = "check"
    })
end

